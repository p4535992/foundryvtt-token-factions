<form class="flexcol" style="margin-bottom: 8px;">
  <div class="form-group">
    <label>{{localize "token-factions.tokeconfig.customBorder"}}</label>
    <div class="form-fields">
      <input
        type="checkbox"
        data-edit="flags.token-factions.customBorder"
        name="flags.token-factions.customBorder"
        data-dtype="Boolean"
        value="{{currentCustomBorder}}"
        {{#if currentCustomBorder}}checked{{/if}}
      />
    </div>
  </div>

  <div class="form-group slim">
    <label>{{localize "token-factions.tokeconfig.customColorInt"}}</label>
    <div class="form-fields">
      <color-picker value="{{currentCustomColorTokenInt}}" name="flags.token-factions.customColorInt">
        <input type="text" value="{{currentCustomColorTokenInt}}" />
        <input type="color" />
      </color-picker>
    </div>
  </div>

  <div class="form-group slim">
    <label>{{localize "token-factions.tokeconfig.customColorExt"}}</label>
    <div class="form-fields">
      <color-picker value="{{currentCustomColorTokenExt}}" name="flags.token-factions.customColorExt">
        <input type="text" value="{{currentCustomColorTokenExt}}" />
        <input type="color" />
      </color-picker>
    </div>
  </div>

  <div class="form-group slim">
    <label>{{localize "token-factions.tokeconfig.customFrameOpacity"}}</label>
    <div class="form-fields">
      <range-picker
        name="flags.token-factions.customFrameOpacity"
        value="{{currentCustomColorTokenFrameOpacity}}"
        min="0"
        max="1"
        step="0.01"
      >
        <input type="range" min="0" max="1" step="0.01" />
        <input type="number" min="0" max="1" step="0.01" />
      </range-picker>
    </div>
  </div>

  <div class="form-group slim">
    <label>{{localize "token-factions.tokeconfig.customBaseOpacity"}}</label>
    <div class="form-fields">
      <range-picker
        name="flags.token-factions.customBaseOpacity"
        value="{{currentCustomColorTokenBaseOpacity}}"
        min="0"
        max="1"
        step="0.01"
      >
        <input type="range" min="0" max="1" step="0.01" />
        <input type="number" min="0" max="1" step="0.01" />
      </range-picker>
    </div>
  </div>
</form> 